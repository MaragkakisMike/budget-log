{
  "expo": {
    "scheme": "acme",
    "plugins": ["expo-router", "expo-sqlite"],
    "sdkVersion": "54.0.0",
    "web": {
      "bundler": "metro"
    },
    "name": "BudgetLog",
    "slug": "budgetlog",
    "icon": "./src/assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "version": "1.1.0",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.budgetlog.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "bundleIdentifier": "com.budgetlog.app",
      "supportsTablet": true
    },

    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "37ec8eef-9290-4694-a99b-64e3b2ac562f"
      }
    }
  }
}
